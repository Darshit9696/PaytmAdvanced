# =============================================================================
# Bank Simulation Gateway (apps/bank-app) Environment Configuration
# =============================================================================

PORT=3001

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/paypulse?sslmode=disable"

# Shared Webhook Authentication Secret
BANK_WEBHOOK_SECRET="development-mock-webhook-secret-key-paypulse"

# User App Webhook URLs for On-Ramp and Off-Ramp Settlement Callbacks
USER_APP_WEBHOOK_URL="http://localhost:3000/api/webhook"
USER_APP_OFFRAMP_WEBHOOK_URL="http://localhost:3000/api/offramp-webhook"

# Public Client-side URL for Consumer Dashboard Redirection
NEXT_PUBLIC_USER_APP_URL="http://localhost:3000"
