# =============================================================================
# Database Package (@repo/db) Environment Configuration
# =============================================================================

# PostgreSQL Connection String (used by Prisma CLI for migrations and schema introspection)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/paypulse?sslmode=disable"

# Optional: Direct (non-pooled) PostgreSQL Connection String
# Used for schema migrations on a non-pooled connection (e.g. Neon or Supabase session pooler bypass)
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/paypulse?sslmode=disable"
