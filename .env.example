# =============================================================================
# PayPulse Monorepo Root Environment Configuration (Template)
# 
# NOTE: This application is a payments simulator. No real money or actual banking
# integrations are involved.
#
# Copy this file to .env or create app-specific .env.local files as needed.
# NEVER commit production secrets or real database credentials to Git.
# =============================================================================

# PostgreSQL Database Connection String
# e.g., local PostgreSQL instance or Neon Serverless Postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/paypulse?sslmode=disable"

# NextAuth Shared Secret (used for signing JWT session tokens)
# Generate a secure 32-character hex key in production: openssl rand -base64 32
NEXTAUTH_SECRET="development-mock-secret-key-paypulse-2026"

# Port / Service URLs
USER_APP_URL="http://localhost:3000"
BANK_APP_URL="http://localhost:3001"
MERCHANT_APP_URL="http://localhost:3002"

# Bank Webhook Settlement Endpoints
USER_APP_WEBHOOK_URL="http://localhost:3000/api/webhook"
USER_APP_OFFRAMP_WEBHOOK_URL="http://localhost:3000/api/offramp-webhook"

# Optional Redis Connection (for BullMQ background jobs & persistent rate limiting)
# REDIS_URL="redis://localhost:6379"
